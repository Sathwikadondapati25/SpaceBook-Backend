# SpaceBook Backend Environment Variables
# Copy this file to .env and fill in the values

# JWT Secret (minimum 256 bits for security)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-min-256-bits

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Organizer invite code (required to register as an organizer)
# Generate a unique code and keep it secret
ORGANIZER_INVITE_CODE=your-organizer-invite-code-here

# Database configuration (required)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/spacebook?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-database-password-here
